# Ralph config: OpenCode (DeepSeek for coding) + Aider review (Kimi K2.6 via OpenRouter)
# Usage:  source .env.deepseek-kimi && ./ralph.sh <repo> 7 --tool opencode
#
# Fill in the two keys below, then `source` this file before running Ralph.
# (Gitignored — safe to put real keys here.)

export RALPH_REMOTE_ENV="$HOME/.local/bin/ralph-opencode-deepseek.env"

# --- Coding loop: DeepSeek direct (cheap; cache-hit input is ~free) ----------
export OPENAI_API_KEY="sk-REPLACE_WITH_DEEPSEEK_KEY"
export DEEPSEEK_API_KEY="$OPENAI_API_KEY"
export OPENAI_BASE_URL="https://api.deepseek.com/v1"
export OPENCODE_MODEL="deepseek-chat"          # or "deepseek-v4-pro" for the stronger coder

# --- Aider review gate: Kimi K2.6 via OpenRouter -----------------------------
# Independent from the coder (different model = real second opinion); review runs
# on small diffs so Kimi's price is ~1-2c per review. litellm routes openrouter/*
# natively via OPENROUTER_API_KEY (no base URL needed).
export OPENROUTER_API_KEY="sk-or-REPLACE_WITH_OPENROUTER_KEY"
export AIDER_REVIEW_MODEL="openrouter/moonshotai/kimi-k2.6"

# --- Cost tracking (.ralph-cost.log) -----------------------------------------
# USD per 1M INPUT tokens for the est_cost_usd column (DeepSeek ≈ 0.27; Kimi ≈ 0.74).
export RALPH_COST_PER_MTOK_INPUT="0.27"

# --- Auto-push when the loop finishes (opt-in) -------------------------------
# Runs once when ralph.sh exits (completed or max iterations). With the server
# deploy webhook, this single push triggers an auto-rebuild + Slack notify.
# export RALPH_ON_COMPLETE="pullscript.sh . -p"   # or "git push"

# Make sure nothing redirects to a local/LiteLLM endpoint
unset ANTHROPIC_BASE_URL
unset ANTHROPIC_API_KEY
